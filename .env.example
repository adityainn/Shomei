# Shomei Deletion Audit Engine — Environment Configuration Example
# Copy this file to .env for local overrides. Never commit .env to public repositories.

# Path to the data directory (default: dataset)
SHOMEI_DATASET_DIR=dataset

# Path for generated audit prediction CSV (default: output.csv)
SHOMEI_OUTPUT_PATH=output.csv

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_BASE=dark

# Logging Verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
